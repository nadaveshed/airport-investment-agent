{
  "name": "airport-investment-agent",
  "version": "1.0.0",
  "description": "AI agent that helps analysts identify US airport expansion opportunities using public aviation data and deterministic scoring",
  "type": "module",
  "main": "dist/src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:web": "vite web",
    "build": "tsc -p tsconfig.build.json && vite build web",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "ingest": "tsx scripts/ingest.ts",
    "eval": "tsx --env-file-if-exists=.env scripts/eval.ts",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "license": "MIT",
  "dependencies": {
    "dompurify": "^3.4.16",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "fast-xml-parser": "^5.11.2",
    "marked": "^18.1.0",
    "openai": "^7.28.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/adm-zip": "^0.5.8",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "adm-zip": "^0.6.1",
    "concurrently": "^10.0.5",
    "csv-parse": "^7.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.3"
  }
}
