# Which LLM provider to use first: gemini | deepseek
LLM_PROVIDER=deepseek
# Optional: the other provider is used as a fallback on 429/5xx when its key is set
GOOGLE_API_KEY=   # GEMINI_API_KEY is also accepted
GEMINI_MODEL=gemini-3.8-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

PORT=3000
LOG_LEVEL=info
